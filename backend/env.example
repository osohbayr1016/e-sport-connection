# ========================================
# E-Sport Connection Backend Environment
# ========================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Format: mongodb+srv://<user>:<password>@<cluster>/<database>
# Production: mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_URI=REPLACE_ME

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=7d

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=REPLACE_ME

# OAuth Configuration (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=REPLACE_ME

# OAuth Configuration (Facebook)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=REPLACE_ME

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# Streaming Configuration
# Twitch API
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=REPLACE_ME

# YouTube API
YOUTUBE_API_KEY=REPLACE_ME

# RTMP Server Configuration
RTMP_SERVER_URL=rtmp://localhost:1935/live

# Frontend Domain (for embed URLs)
FRONTEND_DOMAIN=localhost

# ========================================
# Deployment Notes:
# ========================================
# 1. Set NODE_ENV=production for production
# 2. Use strong, unique secrets for JWT_SECRET and SESSION_SECRET
# 3. Update FRONTEND_URL to your production frontend URL
# 4. Use MongoDB Atlas or your preferred MongoDB provider
# 5. Configure OAuth apps in Google/Facebook developer consoles
# 6. Set up environment variables in your deployment platform 